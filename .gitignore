# Fichiers de configuration et données utilisateur
# (Comme demandé)
config/data.csv

# Macros créées par l'utilisateur. La routine Telegram distribuée reste
# suivie pour qu'un clone propre soit immédiatement fonctionnel.
config/macros/*
!config/macros/Reload CoC.json

# Fichiers générés par l'application
config/app.log
config/app.log.* # Logs en rotation
config/selftest/
config/screenshots/

# Fichiers temporaires (écriture atomique)
config/*.tmp.*
config/macros/*.tmp.*
*.tmp
*.log

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.coverage

# Environnements virtuels
venv/
.venv/
env/
.env

# IDE / OS
.vscode/
.idea/
.DS_Store
