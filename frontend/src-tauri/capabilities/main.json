{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Accès IPC minimal de la fenêtre principale AUTO-COC.",
  "windows": ["main"],
  "platforms": ["windows"],
  "permissions": [
    "allow-get-snapshot",
    "allow-get-macro",
    "allow-create-macro",
    "allow-rename-macro",
    "allow-delete-macro",
    "allow-select-macro",
    "allow-start-recording",
    "allow-stop-recording",
    "allow-start-playback",
    "allow-stop-playback",
    "allow-cancel-resume-wait",
    "allow-patch-settings",
    "allow-put-shortcuts",
    "allow-launch-coc",
    "allow-screenshot",
    "allow-open-macros-folder",
    "allow-quit-application",
    "allow-telegram-config",
    "allow-telegram-config-clear",
    "allow-pairing-start",
    "allow-pairing-cancel",
    "allow-telegram-test",
    "allow-get-migration",
    "allow-select-migration-source",
    "allow-import-migration",
    "allow-shutdown-prepare",
    "allow-shutdown-confirm",
    "allow-get-help",
    "allow-get-diagnostics",
    "allow-complete-onboarding",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
